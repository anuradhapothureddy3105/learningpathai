# Sky Route — AI Mentor Optional API Configuration
# Note: The application includes smart offline fallbacks and works without any API keys.
# If you wish to connect an external AI model directly, set your endpoint / keys here:

# Example: Anthropic API key (if proxying requests via secure backend)
VITE_ANTHROPIC_API_KEY=

# Example: Gemini API Key (for future Google GenAI integrations)
VITE_GEMINI_API_KEY=

# Optional API endpoint / backend server URL
VITE_API_BASE_URL=
